---
import "../styles/global.css";
import { getImage } from "astro:assets";
import defaultOgSource from "../../assets/device_frames/en/mac-14/workspace.png";
import { copy, localizedPath, siteOrigin, supportedLocales, type SiteLocale } from "../lib/i18n";

interface Props {
  title: string;
  description: string;
  locale?: SiteLocale;
  pagePath?: string;
  autoDetectLanguage?: boolean;
  ogImage?: string;
}

const {
  title,
  description,
  locale = "en",
  pagePath = "/",
  autoDetectLanguage = false,
  ogImage,
} = Astro.props;
const defaultOgImage = await getImage({
  src: defaultOgSource,
  format: "jpg",
  width: 1200,
  quality: 80,
  background: "#f7f9fa",
});
const resolvedOgImage = ogImage ?? defaultOgImage.src;
const canonicalPath = localizedPath(locale, pagePath);
const canonical = new URL(canonicalPath, siteOrigin).toString();
const languageName = locale === "en" ? "English" : locale === "zh-Hans" ? "简体中文" : "繁體中文";
---

<!doctype html>
<html lang={locale} data-locale={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f9fa" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {supportedLocales.map((candidate) => (
      <link rel="alternate" hreflang={candidate} href={new URL(localizedPath(candidate, pagePath), siteOrigin)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(pagePath, siteOrigin)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Termind" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(resolvedOgImage, siteOrigin)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline define:vars={{ autoDetectLanguage }}>
      (() => {
        const storageKey = "termind.locale";
        const supported = new Set(["en", "zh-Hans", "zh-Hant"]);
        const languages = Array.isArray(navigator.languages) && navigator.languages.length
          ? navigator.languages
          : [navigator.language || "en"];
        const normalized = languages.map((language) => language.toLowerCase());
        const isTaiwan = normalized.some((language) => language === "zh-tw" || language.startsWith("zh-tw-"));
        document.documentElement.dataset.traditionalName = isTaiwan ? "正體中文" : "繁體中文";

        const detect = () => {
          for (const language of normalized) {
            if (language === "zh-tw" || language.startsWith("zh-tw-") || language.includes("hant")) {
              return "zh-Hant";
            }
            if (language === "zh-hk" || language.startsWith("zh-hk-") || language === "zh-mo" || language.startsWith("zh-mo-")) {
              return "zh-Hant";
            }
            if (language === "zh" || language.startsWith("zh-cn") || language.startsWith("zh-sg") || language.startsWith("zh-my") || language.includes("hans")) {
              return "zh-Hans";
            }
            if (language.startsWith("en")) return "en";
          }
          return "en";
        };

        let saved = null;
        try { saved = localStorage.getItem(storageKey); } catch {}
        if (autoDetectLanguage && location.pathname === "/") {
          const selected = supported.has(saved) ? saved : detect();
          if (!supported.has(saved)) {
            try { localStorage.setItem(storageKey, selected); } catch {}
          }
          const target = selected === "zh-Hans" ? "/zh-hans/" : selected === "zh-Hant" ? "/zh-hant/" : "/";
          if (target !== location.pathname) location.replace(target);
        }

        addEventListener("DOMContentLoaded", () => {
          document.querySelectorAll("[data-traditional-label]").forEach((node) => {
            node.textContent = isTaiwan ? "正體中文" : "繁體中文";
          });
          document.querySelectorAll("[data-locale-option]").forEach((link) => {
            link.addEventListener("click", () => {
              const selected = link.getAttribute("data-locale-option");
              if (supported.has(selected)) {
                try { localStorage.setItem(storageKey, selected); } catch {}
              }
            });
          });
        });
      })();
    </script>
  </head>
  <body>
    <header class="site-header shell">
      <a class="brand" href={localizedPath(locale)} aria-label={copy(locale, "Termind home", "Termind 首页")}>
        <img src="/brand_mark.svg" width="38" height="38" alt="" />
        <span>Termind</span>
      </a>
      <nav aria-label={copy(locale, "Primary navigation", "主导航")}>
        <a href={localizedPath(locale, "/faq/")}>
          FAQ
        </a>
        <a href={localizedPath(locale, "/pricing/")} aria-current={pagePath === "/pricing/" ? "page" : undefined}>
          {copy(locale, "Pricing", "价格")}
        </a>
        <a href={localizedPath(locale, "/compare/")} aria-current={pagePath.startsWith("/compare/") ? "page" : undefined}>
          {copy(locale, "Compare", "对比")}
        </a>
        <a href={localizedPath(locale, "/security/")}>
          {copy(locale, "Security", "安全")}
        </a>
        <a href={localizedPath(locale, "/privacy/")}>
          {copy(locale, "Privacy", "隐私")}
        </a>
        <a href={localizedPath(locale, "/support/")}>
          {copy(locale, "Support", "支持")}
        </a>
        <details class="language-picker">
          <summary><span data-traditional-label={locale === "zh-Hant" ? true : undefined}>{languageName}</span></summary>
          <div>
            <a href={localizedPath("en", pagePath)} data-locale-option="en" aria-current={locale === "en" ? "page" : undefined}>English</a>
            <a href={localizedPath("zh-Hans", pagePath)} data-locale-option="zh-Hans" aria-current={locale === "zh-Hans" ? "page" : undefined}>简体中文</a>
            <a href={localizedPath("zh-Hant", pagePath)} data-locale-option="zh-Hant" aria-current={locale === "zh-Hant" ? "page" : undefined}><span data-traditional-label>繁體中文</span></a>
          </div>
        </details>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer shell">
      <div>
        <span class="status-dot" aria-hidden="true"></span>
        <span>{copy(locale, "Local first. Private by default.", "本地优先，默认私密。")}</span>
      </div>
      <p>© 2026 Termind</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 82px;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand img {
    display: block;
  }

  nav { display: flex; align-items: center; gap: 1.7rem; }
  nav a {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color 150ms ease;
  }
  nav a:hover, nav a[aria-current="page"] { color: var(--ink); }
  .language-picker { position: relative; }
  .language-picker summary {
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.72rem;
    font-weight: 600;
    list-style: none;
  }
  .language-picker summary::-webkit-details-marker { display: none; }
  .language-picker div {
    position: absolute;
    z-index: 30;
    top: calc(100% + .65rem);
    right: 0;
    display: grid;
    min-width: 148px;
    padding: .45rem;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    background: rgba(255,255,255,.96);
    box-shadow: 0 18px 48px rgba(38,52,61,.14);
    backdrop-filter: blur(18px);
  }
  .language-picker div a { padding: .55rem .65rem; border-radius: 10px; }
  .language-picker div a:hover, .language-picker div a[aria-current="page"] { background: var(--paper); color: var(--ink); }
  .language-picker:not([open]) div { display: none; }

  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 116px;
    margin-top: 7rem;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: 0.75rem;
  }
  .site-footer div { display: flex; align-items: center; gap: 0.6rem; }
  .site-footer p { margin: 0; }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 14px rgba(38, 52, 61, 0.4);
  }

  @media (max-width: 900px) {
    .site-header { flex-wrap: wrap; gap: 1rem; padding-block: 1rem; }
    nav { gap: .85rem; flex-wrap: wrap; }
  }
  @media (max-width: 640px) {
    .site-footer {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      gap: 0.5rem;
    }
  }
</style>
