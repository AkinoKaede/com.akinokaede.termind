  .hero-decoration { position: absolute; inset: 3rem 0 auto; height: 260px; pointer-events: none; z-index: -1; color: #c5dae9; text-align: left; }
  .hero-decoration span { position: absolute; left: 4%; top: 50px; font: 2.5rem var(--mono); transform: rotate(-10deg); }
