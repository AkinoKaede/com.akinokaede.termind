  .hero-decoration b { position: absolute; right: 4%; top: -8px; letter-spacing: .4rem; transform: rotate(12deg); }
  .composition-orbit { position: absolute; z-index: -1; inset: 8% 2% 9%; border: 1px dashed #c7dce9; border-radius: 50%; transform: rotate(-9deg); }
  .composition-caption { position: absolute; inset: auto 0 0; display: flex; justify-content: space-between; color: var(--faint); font: .6rem var(--mono); letter-spacing: .1em; }
  .closing { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; padding-block: 7rem 2rem; text-align: center; }
  .closing h2 { font-size: clamp(3rem,6vw,5.5rem); }
