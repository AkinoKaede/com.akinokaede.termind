  .closing-download { display: inline-flex; gap: 2rem; padding: 1rem 1.5rem; border-radius: 999px; background: var(--ink); color: white; text-decoration: none; font-size: .85rem; }
  .app-store-button, .closing-download { transition: transform 180ms ease, background 180ms ease; }
