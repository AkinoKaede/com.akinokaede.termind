---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScreenshotPicture from "../components/ScreenshotPicture.astro";
import TelegramOffer from "../components/TelegramOffer.astro";
import TailscaleFeature from "../components/TailscaleFeature.astro";
import { assetLocale, copy, localizedPath, type SiteLocale } from "../lib/i18n";
import { duoInnerFrame, duoOuterFrame, ipadFrame, iphoneFrame, workspaceFrame } from "../lib/marketingImages";
import { termindPricing } from "../lib/pricing";

interface Props { locale?: SiteLocale; }
const { locale = "en" } = Astro.props;
const c = (english: string, simplified: string) => copy(locale, english, simplified);
const languageAsset = assetLocale(locale);
const macWorkspace = workspaceFrame(languageAsset);
---

<BaseLayout
  title={c("Termind: AI-driven remote workspace for Mac, iPhone, and iPad", "Termind：AI 驱动的远程工作台，适用于 Mac、iPhone 与 iPad")}
  description={c(
    "AI-driven remote work with SSH, SFTP, live metrics, and built-in Tailscale. Bring your own model key and control what AI can do.",
    "AI 驱动的远程工作台，集 SSH、SFTP、实时监控与内置 Tailscale 于一体。使用你自己的模型密钥，由你决定 AI 能做什么。"
  )}
  locale={locale}
  pagePath="/"
  autoDetectLanguage={locale === "en"}
>
  <section class="hero shell">
    <div class="hero-copy reveal">
      <p class="eyebrow">{c("AI-DRIVEN REMOTE WORKSPACE", "AI 驱动的远程工作台")}</p>
      <h1 class="display">{c("Command with ease,", "随心发令，")}<br /><em>{c("stay in control.", "从容掌控。")}</em></h1>
      <p class="lede">{c(
        "Generate commands, investigate issues, and act on your servers with AI—using your own model key and permissions you control. SSH, SFTP, live metrics, and built-in Tailscale come together in one workspace.",
        "让 AI 协助你生成命令、排查问题并操作远程服务器。使用你自己的模型密钥，并在你设定的权限下安全执行。SSH、SFTP、实时监控与内置 Tailscale 汇聚在同一个工作台。"
      )}</p>
      <div class="hero-actions">
        <a
          class="app-store-button"
          href="https://apps.apple.com/app/apple-store/id6805856690"
          aria-label={c("Download Termind on the App Store", "在 App Store 下载 Termind")}
        >
          <span class="apple" aria-hidden="true"></span>
          <span class:list={["store-copy", { chinese: locale !== "en" }]}>
            {locale === "en" ? (
              <><small>Download on the</small><strong>App Store</strong></>
            ) : (
              <><strong>App Store</strong><small>{c("", "下载")}</small></>
            )}
          </span>
        </a>
        <a class="text-link" href="#platforms">{c("Explore Termind", "了解 Termind")} <span>↓</span></a>
      </div>
      <div class="requirements" aria-label={c("System requirements", "系统要求")}><span>macOS 15+</span><i></i><span>iOS 18+</span><i></i><span>iPadOS 18+</span></div>
    </div>

    <div class="device-composition reveal" style="animation-delay: 120ms" aria-label={c("Termind workspace and AI Assistant", "Termind 工作区与 AI 助手")}>
      <figure class="device mac hero-mac"><ScreenshotPicture src={macWorkspace} width={1800} loading="eager" fetchpriority="high" alt={c("Termind multi-pane workspace on Mac", "Mac 上的 Termind 多窗格工作区")} /></figure>
      <figure class="device hero-duo"><ScreenshotPicture src={duoOuterFrame("assistant", languageAsset)} width={1000} loading="eager" alt={c("Termind AI Assistant on the iPhone Duo outer display", "iPhone Duo 外屏上的 Termind AI Assistant")} /></figure>
      <div class="sync-badge"><span></span>{c("iCloud sync", "iCloud 同步")}</div>
    </div>
  </section>

  <section class="platform-band" id="platforms"><div class="shell platform-grid">
    <article><span>01</span><strong>Mac</strong><p>{c("Multi-pane control room", "多窗格控制台")}</p></article>
    <article><span>02</span><strong>iPhone</strong><p>{c("A terminal in reach", "触手可及的终端")}</p></article>
    <article><span>03</span><strong>iPad</strong><p>{c("Full SFTP and live metrics", "完整 SFTP 与实时监控")}</p></article>
  </div></section>

  <TailscaleFeature locale={locale} />

  <section class="performance shell" aria-labelledby="performance-title">
    <header class="performance-heading">
      <div>
        <p class="performance-kicker">{c(
          "TERMIND EXCLUSIVE · MULTI-CONNECTION PORT FORWARDING",
          "TERMIND 独有 · 多连接端口转发"
        )}</p>
        <h2 class="display" id="performance-title">{c(
          "More connections. Less waiting.",
          "更多连接，更少等待。"
        )}</h2>
        <p>{c(
          "Termind uniquely accelerates local port forwarding across multiple SSH connections. It delivers 2.54× the throughput of single-connection mode—reaching 3,869.7 Mbps in our loopback test. SFTP transfers also use similar multi-threaded parallelism.",
          "Termind 独有的多连接技术，可通过多条 SSH 连接加速本地端口转发。相较单连接模式，吞吐量达到 2.54 倍，在本机回环测试中达到 3,869.7 Mbps。SFTP 传输也采用类似的多线程并行机制。"
        )}</p>
      </div>
      <div class="performance-result" aria-label={c("2.54 times the throughput", "2.54 倍吞吐量")}>
        <strong>2.54<span>×</span></strong>
        <small>{c("THE THROUGHPUT", "吞吐量")}</small>
      </div>
    </header>

    <div class="benchmark" role="img" aria-label={c(
      "Throughput benchmark in Mbps per direction: Termind with 12 connections, 3,869.7; Termind with one connection, 1,524.2; Termius, 1,628.2; OpenSSH, 1,585.4.",
      "单向吞吐量基准测试，单位为 Mbps：Termind 12 条连接为 3,869.7，Termind 单连接为 1,524.2，Termius 为 1,628.2，OpenSSH 为 1,585.4。"
    )}>
      <div class="benchmark-axis" aria-hidden="true">
        <span>0</span><span>900</span><span>1800</span><span>2700</span><span>3600</span><span>4500</span>
      </div>
      <div class="benchmark-row winner">
        <div class="benchmark-label"><strong>Termind 1.10.2</strong><span>{c("12 connections", "12 条连接")}</span></div>
        <div class="benchmark-track"><i style="--bar-size: 85.99%"></i><b>3,869.7</b></div>
      </div>
      <div class="benchmark-row">
        <div class="benchmark-label"><strong>Termind 1.10.2</strong><span>{c("1 connection", "单连接")}</span></div>
        <div class="benchmark-track"><i style="--bar-size: 33.87%"></i><b>1,524.2</b></div>
      </div>
      <div class="benchmark-row competitor">
        <div class="benchmark-label"><strong>Termius 10.0.6</strong></div>
        <div class="benchmark-track"><i style="--bar-size: 36.18%"></i><b>1,628.2</b></div>
      </div>
      <div class="benchmark-row competitor">
        <div class="benchmark-label"><strong>OpenSSH 10.3p1</strong></div>
        <div class="benchmark-track"><i style="--bar-size: 35.23%"></i><b>1,585.4</b></div>
      </div>
    </div>
    <footer class="benchmark-note">
      <span>{c(
        "Loopback · 64 concurrent TCP flows · Median of 5 runs",
        "本机回环 · 64 路并发 TCP 流 · 5 次运行中位数"
      )}</span>
      <span>Apple M3 Pro · macOS 26.6.2</span>
      <span>{c("Tested September 20, 2026", "测试日期：2026 年 9 月 20 日")}</span>
      <span>{c(
        "Useful payload per direction (Mbps) · higher is better",
        "单向有效载荷（Mbps）· 数值越高越好"
      )}</span>
    </footer>
  </section>

  <section class="story shell">
    <header class="story-heading"><p class="eyebrow">{c("BUILT AROUND THE WORK", "围绕任务设计")}</p><h2 class="display">{c("The right tool,", "需要什么，")}<br /><em>{c("at the right moment.", "就呈现什么。")}</em></h2></header>

    <article class="story-row phone-row">
      <div class="story-copy"><span class="feature-no">01 / IPHONE · SSH</span><h3>{c("A real terminal, wherever you are.", "真正的终端，随手即达。")}</h3><p>{c("Open an SSH workspace, use a touch-aware terminal keyboard, search output, recall snippets, and generate an inspectable command without giving up control of Return.", "打开 SSH 工作区，用触控终端键盘、输出搜索与命令片段完成操作；命令生成器只把可检查的命令放入输入区，回车始终由你决定。")}</p><ul><li>{c("Touch-first terminal controls", "为触控优化的终端控制")}</li><li>{c("Snippets and command history", "命令片段与历史记录")}</li><li>{c("Command Generator never presses Return", "命令生成器绝不替你按下回车")}</li></ul></div>
      <div class="product-field phone-field"><figure class="device iphone feature-phone"><ScreenshotPicture src={iphoneFrame("ssh", languageAsset)} width={765} loading="lazy" alt={c("SSH terminal with production service output on iPhone", "iPhone 上显示生产服务输出的 SSH 终端")} /></figure><span class="field-note">iPHONE · PORTRAIT</span></div>
    </article>

    <article class="story-row reverse unfolded-row">
    <div class="story-copy"><span class="feature-no">02 / IPHONE DUO · SFTP</span><h3>{c("Move files. Keep your flow.", "传文件，不必换工具。")}</h3><p>{c("Browse, preview, drag to upload, and track concurrent transfers. Open the same live path in SSH without rebuilding context.", "浏览、预览、拖入上传并跟踪并发传输；还能从当前路径直接切到 SSH，不必重新定位。")}</p><ul><li>{c("A complete SFTP workflow, built for touch", "触控优化的完整 SFTP 工作流")}</li><li>{c("Concurrent transfers continue in the background", "并发传输持续在后台运行")}</li><li>{c("Open the same live path in SSH", "同一路径直接切换 SSH")}</li></ul></div>
      <div class="product-field unfolded-field"><figure class="device feature-duo"><ScreenshotPicture src={duoInnerFrame("sftp", languageAsset)} width={1600} loading="lazy" alt={c("SFTP file browser on the unfolded iPhone Duo", "展开的 iPhone Duo 上的 SFTP 文件浏览器")} /></figure><span class="field-note">{c("SFTP · FILE TRANSFER", "SFTP · 文件传输")}</span></div>
    </article>

    <article class="story-row metrics-row">
    <div class="story-copy"><span class="feature-no">03 / IPAD · METRICS</span><h3>{c("Know which server needs you.", "哪台服务器需要你，一眼就知道。")}</h3><p>{c("See CPU, memory, disks, network interfaces, and processes together. Spot hot servers, drill into resource pressure, and keep working over the same SSH connection.", "CPU、内存、磁盘、网卡与进程同屏呈现；快速定位异常主机，深入查看资源压力，并沿同一 SSH 连接继续处理。")}</p></div>
      <div class="product-field wide-field"><figure class="device ipad feature-ipad"><ScreenshotPicture src={ipadFrame("metrics", languageAsset)} width={1480} loading="lazy" alt={c("Server metrics and processes on iPad", "iPad 上的服务器监控与进程列表")} /></figure><div class="metric-pulse"><i></i><span>{c("Live over your SSH connection", "通过你的 SSH 连接实时采样")}</span></div></div>
    </article>

    <article class="story-row reverse assistant-row">
      <div class="story-copy">
        <span class="feature-no">04 / IPHONE DUO · ASSISTANT</span>
        <h3>{c("Takes action.", "能行动，")}<br />{c("Remembers.", "也有记忆。")}</h3>
        <p>{c("Ask the AI Assistant to investigate a server issue, explain what it finds, and take action through your saved hosts. Bring your own model key and choose the permissions it works within.", "让 AI 助手排查服务器问题、分析故障原因，并通过已保存的主机执行操作。使用你自己的模型密钥，由你决定它的行动权限。")}</p>
        <p>{c("Enable Hermes Memory to carry useful context and preferences into new conversations—less repeating yourself, more getting on with the task. Memory is off by default, stored on this device, and yours to review, edit, or delete.", "开启持久化记忆（Hermes Memory），让重要背景与个人偏好延续到新会话。告别反复交代，专注于当下任务。记忆默认关闭，数据仅保存在当前设备，你可以随时查看、编辑或清除。")}</p>
        <div class="trust-line"><span>{c("Your model. Your permissions.", "模型由你选，权限由你定")}</span><span>{c("Optional, device-local memory", "记忆按需开启，不跨设备同步")}</span></div>
        <p class="agentkit-credit">
          <a href="https://github.com/AkinoKaede/AgentKit">AgentKit</a>{c(
            " is the open-source agent runtime behind Termind’s AI Assistant.",
            " 是 Termind AI 助手背后的开源 Agent 运行时。"
          )}
        </p>
      </div>
      <div class="product-field"><figure class="device feature-duo-outer"><ScreenshotPicture src={duoOuterFrame("assistant", languageAsset)} width={1000} loading="lazy" alt={c("Permission-aware AI Assistant on the iPhone Duo outer display", "iPhone Duo 外屏上会请求授权的 AI Assistant")} /></figure><span class="field-note">BYOK · ASK FIRST</span></div>
    </article>

    <article class="story-row vault-row">
      <div class="story-copy"><span class="feature-no">05 / VAULT · ICLOUD</span><h3>{c("Your Vault, protected by design.", "你的保管库，安全为先。")}</h3><p>{c("Keep hosts, snippets, Metrics, and settings—including Connections preferences—in sync through your private iCloud database, while passwords and keys stay separately protected by Keychain.", "主机、命令片段、监控与设置（包括连接偏好）通过你的私有 iCloud 数据库同步；密码和密钥始终由钥匙串独立保护。")}</p></div>
      <div class="product-field duo-field"><figure class="device ipad vault-ipad"><ScreenshotPicture src={ipadFrame("vault", languageAsset)} width={1480} loading="lazy" alt={c("Vault on iPad", "iPad 上的保管库")} /></figure><figure class="device iphone vault-phone"><ScreenshotPicture src={iphoneFrame("vault", languageAsset)} width={765} loading="lazy" alt={c("Vault on iPhone", "iPhone 上的保管库")} /></figure></div>
    </article>
  </section>

  <section class="mac-power"><div class="shell mac-grid">
    <div class="mac-copy"><p class="eyebrow">{c("GO DEEPER ON MAC", "在 Mac 上深入工作")}</p><h2 class="display">{c("Your full control room.", "你的完整控制台。")}</h2><p>{c("Compose SSH, Telnet, SFTP, and serial sessions into multi-pane workspaces and broadcast input between terminals for free. Pro adds the built-in loopback-only MCP server for audited SSH/SFTP tools.", "免费将 SSH、Telnet、SFTP 与串口会话组合成多窗格工作区，并支持在终端间广播输入。Pro 方案还提供默认仅监听本机回环地址的内置 MCP 服务器，可使用经过审计的 SSH 与 SFTP 工具。")}</p><div class="mac-only"><span>MAC ONLY</span><span>{c("Multi-pane", "多窗格")}</span><span>{c("Serial", "串口")}</span><span>{c("Built-in MCP server", "内置 MCP 服务器")}</span></div></div>
    <figure class="device mac mac-shot"><ScreenshotPicture src={macWorkspace} width={1800} fallbackBackground="#26343d" loading="lazy" alt={c("Multi-pane Termind workspace on Mac", "Mac 上的 Termind 多窗格工作区")} /></figure>
  </div></section>

  <section class="mcp-highlight shell">
    <div class="mcp-copy">
      <p class="eyebrow">MAC ONLY · BUILT-IN MCP SERVER</p>
      <h2 class="display">{c("Give local AI", "让本地 AI 调用")}<br /><em>{c("secure remote tools.", "安全的远程能力。")}</em></h2>
      <p>{c(
        "Turn on Termind’s built-in MCP server and local clients can list saved hosts, execute SSH commands, and read or write through SFTP. Expose tools one by one, keep access on loopback by default, and retain an audit trail for every external call.",
        "开启 Termind 内置 MCP 服务器后，本地客户端可以列出已保存主机、执行 SSH 命令，并通过 SFTP 读写文件。工具支持逐项授权开放，默认仅监听本机回环地址，每次外部调用均记录审计日志。"
      )}</p>
      <div class="mcp-points"><span>{c("Loopback only by default", "默认仅监听本机")}</span><span>{c("Per-tool controls", "逐项控制工具")}</span><span>{c("Calls audited", "调用留有审计")}</span></div>
    </div>
    <div class="mcp-diagram" aria-label={c("Local AI clients connect through Termind MCP to SSH and SFTP tools", "本地 AI 客户端通过 Termind MCP 连接 SSH 与 SFTP 工具")}>
      <div class="client-stack">
        <div><img src="/brands/codex.svg" width="24" height="24" alt="" /><span>Codex</span></div>
        <div><img src="/brands/claude_code.svg" width="24" height="24" alt="" /><span>Claude Code</span></div>
        <div><img src="/brands/pi.svg" width="24" height="24" alt="" /><span>Pi</span></div>
      </div>
      <div class="mcp-path" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="mcp-core"><img src="/brand_mark.svg" width="72" height="72" alt="" /><strong>TERMIND</strong><span>MCP</span></div>
      <div class="mcp-path out" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="tool-stack"><span>list_hosts</span><span>ssh_exec</span><span>sftp_read</span><span>sftp_write</span></div>
    </div>
    <p class="mcp-footnote">{c(
      "Codex is a product of OpenAI; Claude Code is a product of Anthropic; Pi is developed by Mario Zechner. Names and marks belong to their respective owners and are shown only to describe compatibility. Termind is not affiliated with, sponsored by, or endorsed by them.",
      "Codex 是 OpenAI 的产品；Claude Code 是 Anthropic 的产品；Pi 由 Mario Zechner 开发。上述名称和标志归各自权利人所有，仅用于说明兼容性；Termind 与其无隶属、合作或背书关系。"
    )}</p>
  </section>

  <section class="pro shell"><div><p class="eyebrow">TERMIND PRO</p><h2 class="display">{c("Subscribe annually—or keep it forever.", "按年订阅，或永久拥有。")}</h2><p>{c("Core SSH, Telnet, SFTP, terminal uploads, snippets, Command Generator, and port forwarding stay free, as do serial sessions, multi-pane workspaces, and input broadcasting on Mac. Annual or lifetime Pro unlocks built-in Tailscale, the AI Assistant with optional Hermes Memory, monitoring for more than 3 servers, remote MCP clients, iCloud sync, and the built-in MCP server on Mac.", "基础 SSH、Telnet、SFTP、终端上传、命令片段、命令生成器、端口转发，以及 Mac 串口、多窗格工作区和广播输入永久免费。年度订阅或永久版可解锁内置 Tailscale、支持持久化记忆的 AI 助手、超过 3 台服务器的监控、远程 MCP 客户端、iCloud 同步，以及 Mac 内置 MCP 服务器。")}</p></div><aside><strong>{c(`${termindPricing.annual}/year · ${termindPricing.lifetime} lifetime`, `${termindPricing.annual}/年 · ${termindPricing.lifetime} 永久版`)}</strong><span>{c("Regional App Store pricing · Family Sharing", "以 App Store 地区价格为准 · 支持家庭共享")}</span><small>{c("Available offers are shown by the App Store. AI provider costs are separate.", "可用优惠以 App Store 当前展示为准；AI 提供方费用另计。")}</small><a href={localizedPath(locale, "/pricing/")}>{c("See all plans", "查看全部方案")} <span aria-hidden="true">→</span></a></aside></section>

  <TelegramOffer locale={locale} />

  <section class="security-guide shell">
    <div class="security-guide-mark" aria-hidden="true">
      <svg viewBox="0 0 48 48" role="presentation">
        <path d="M24 4 8 10v12c0 10.2 6.6 18.6 16 22 9.4-3.4 16-11.8 16-22V10L24 4Z"></path>
        <path d="m16.5 24.5 5 5 10.5-11"></path>
      </svg>
    </div>
    <div class="security-guide-heading">
      <p class="eyebrow">{c("SECURITY, BY DESIGN", "安全，始于设计")}</p>
      <h2 class="display">{c("From your key", "从你的密钥，")}<br /><em>{c("to every action.", "到每一次操作。")}</em></h2>
    </div>
    <div class="security-guide-copy">
      <p>{c(
        "See how Termind protects SSH credentials at rest and in memory, verifies server identity, and places clear boundaries around the Assistant and built-in MCP server.",
        "了解 Termind 如何保护静态存储与内存中的 SSH 凭据、核验服务器身份，并为 AI 助手与内置 MCP 服务器建立清晰边界。"
      )}</p>
      <a href={localizedPath(locale, "/security/")}>{c("Explore security design", "了解安全设计")} <span>→</span></a>
    </div>
  </section>

  <section class="policy-cta shell"><p class="eyebrow">{c("PLAIN-LANGUAGE POLICY", "清晰透明的政策")}</p><div><h2 class="display">{c("Know exactly", "清楚掌握")}<br />{c("where data goes.", "数据去向。")}</h2><div><p>{c("Every meaningful data path is documented—from local storage and Keychain to iCloud, remote hosts, search engines, and your selected model provider.", "从本机存储与钥匙串，到 iCloud、远程主机、搜索引擎以及你选定的模型提供方，每条重要数据路径都有清晰透明的说明。")}</p><a href={localizedPath(locale, "/privacy/")}>{c("Open privacy policy", "打开隐私政策")} <span>→</span></a></div></div></section>
</BaseLayout>

<style>
  .assistant-row .story-copy > p + p { margin-top: 1rem; }
  .assistant-row .story-copy > .agentkit-credit { margin-top: 1.25rem; font-size: .78rem; }
  .agentkit-credit a { color: var(--cyan); text-underline-offset: .2em; }
