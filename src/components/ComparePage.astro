---
import { copy, localizedPath, type SiteLocale } from "../lib/i18n";
import { getComparisonPreviews } from "../lib/comparisons";

interface Props { locale: SiteLocale; }
const { locale } = Astro.props;
const c = (english: string, simplified: string) => copy(locale, english, simplified);
const comparisons = getComparisonPreviews(locale);
---

<article class="compare-page shell">
  <header class="compare-intro reveal">
    <p class="eyebrow">{c("COMPARE", "方案对比")}</p>
    <h1 class="display">{c("A closer look.", "横向对比，")}<br /><em>{c("A clearer choice.", "清楚选择。")}</em></h1>
    <p class="lede">{c(
      "Compare features, limits, and pricing to find the SSH tool that fits your workflow.",
      "深入对比各项功能、规格限制与方案定价，找到最契合你工作流的 SSH 工具。"
    )}</p>
  </header>

  <section aria-labelledby="comparisons-heading">
    <div class="section-label">
      <h2 id="comparisons-heading">{c("Explore the comparisons", "查看对比")}</h2>
      <span>{String(comparisons.length).padStart(2, "0")}</span>
    </div>
    <ul class="comparison-list" role="list">
      {comparisons.map((comparison, index) => (
        <li>
          <a class="comparison-row reveal" href={localizedPath(locale, `/compare/${comparison.slug}/`)}>
            <span class="row-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <div class="row-copy">
              <h3>Termind <span>vs.</span> {comparison.name}</h3>
              <p>{comparison.summary}</p>
              <ul class="topics" aria-label={c("Comparison topics", "对比主题")}>
                {comparison.topics.map((topic) => <li>{topic}</li>)}
              </ul>
            </div>
            <span class="row-link">{c("Read comparison", "查看对比")} <span aria-hidden="true">↗</span></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <aside class="compare-help">
    <p>{c("Getting to know Termind?", "想先了解 Termind？")}</p>
    <a href={localizedPath(locale, "/faq/")}>{c("Start with the FAQ", "从常见问题开始")} <span aria-hidden="true">→</span></a>
  </aside>
</article>

<style>
  .compare-intro { max-width: 850px; padding-block: 5rem 4rem; }
  h1 { margin-top: 1.5rem; font-size: clamp(2.8rem, 6vw, 5.2rem); }
  h1 em { color: var(--cyan); }
  .lede { max-width: 650px; margin: 1.7rem 0 0; color: var(--muted); font-size: 1.08rem; }
  .section-label { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.1rem; }
  .section-label h2 { margin: 0; font-size: .85rem; font-weight: 600; }
  .section-label > span { color: var(--faint); font-family: var(--mono); font-size: .75rem; }
  .comparison-list { padding: 0; margin: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .comparison-row {
    display: grid;
    grid-template-columns: 45px minmax(0, 1fr) auto;
    align-items: start;
    gap: 1.5rem;
    padding: 2rem .8rem;
    border-bottom: 1px solid var(--line-strong);
    text-decoration: none;
    transition: background 180ms ease;
  }
  .comparison-row:hover { background: #eaf5fb; }
  .row-number { padding-top: .5rem; color: var(--cyan); font: .75rem var(--mono); }
  h3 { margin: 0 0 .7rem; font-size: clamp(1.5rem, 3vw, 2.1rem); font-weight: 500; letter-spacing: -.04em; }
  h3 > span { color: var(--faint); font-family: var(--display); font-style: italic; }
  .row-copy > p { max-width: 650px; margin: 0; color: var(--muted); font-size: .93rem; }
  .topics { display: flex; flex-wrap: wrap; gap: .5rem; padding: 0; margin: 1.2rem 0 0; list-style: none; }
  .topics li { padding: .3rem .7rem; border: 1px solid var(--line); border-radius: var(--radius-pill); color: var(--muted); font-size: .72rem; }
  .row-link { display: flex; align-items: center; gap: 1.2rem; padding-top: .3rem; color: var(--cyan); font-size: .85rem; font-weight: 600; }
  .row-link > span { font-size: 1.5rem; }
  .compare-help { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .6rem; margin-top: 2rem; color: var(--muted); font-size: .85rem; }
  .compare-help p { margin: 0; }
  .compare-help a { color: var(--cyan); }
  @media (max-width: 700px) {
    .compare-intro { padding-block: 3.5rem 3rem; }
    .comparison-row { grid-template-columns: 25px minmax(0, 1fr); gap: .7rem; padding: 1.5rem .3rem; }
    .row-link { grid-column: 2; }
  }
</style>
